DATABASE_URL="postgresql://bohanpeta:bohanpeta@localhost:5432/bohanpeta?schema=public"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
PORT=3000

# Result emails (score + review link) sent via Gmail SMTP after each exam
# submission. Leave blank in dev to skip sending — the app logs a warning
# and continues instead of failing the exam. SMTP_APP_PASSWORD is a Gmail
# "App Password" (myaccount.google.com/apppasswords), not your login password.
SMTP_USER=""
SMTP_APP_PASSWORD=""
SMTP_FROM_NAME="BOHAN-PETA"
# Used to build the absolute review link in the email — the web app's origin.
FRONTEND_URL="http://localhost:5173"

# AI-assisted question generation (PRD section 6). Get a free key at
# aistudio.google.com/apikey. Leave blank to disable — the generate
# endpoint returns a clear error instead of failing unpredictably.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
